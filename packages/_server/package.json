{
  "name": "code-spell-checker-server",
  "version": "2.0.0",
  "private": true,
  "description": "Spell Checker Server",
  "license": "MIT",
  "author": "Jason Dent",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/vscode-spell-checker"
  },
  "bin": {
    "build": "./build.mjs"
  },
  "files": [
    "dist",
    "out",
    "spell-checker-config.schema.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/main.cjs",
  "types": "dist/main.d.cts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    },
    "./api": {
      "import": "./out/api.js",
      "require": "./out/api.cjs"
    },
    "./lib": {
      "import": "./out/lib/index.js",
      "require": "./out/lib/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown && npm run build:tsc && npm run build-schema",
    "build-production": "npm run clean-build-production",
    "build-schema": "node ./scripts/build-schema.mts",
    "build:production": "tsdown --production --minify && npm run build-schema",
    "build:tsc": "tsc -p tsconfig.test.json && tsc -p scripts",
    "clean-build-production": "npm run clean && npm run build:production",
    "clean-build": "npm run clean && npm run build",
    "clean": "shx rm -rf dist temp out coverage lib",
    "test": "vitest run"
  },
  "dependencies": {
    "@cspell/cspell-bundled-dicts": "^10.3.1"
  },
  "devDependencies": {
    "@cspell/cspell-pipe": "^10.3.1",
    "@cspell/cspell-types": "^10.3.1",
    "@cspell/url": "^10.3.1",
    "@internal/common-utils": "file:../__utils",
    "cspell-config-lib": "^10.3.1",
    "cspell-gitignore": "^10.3.1",
    "cspell-glob": "^10.3.1",
    "cspell-io": "^10.3.1",
    "cspell-lib": "^10.3.1",
    "gensequence": "^8.0.8",
    "json-rpc-api": "file:../json-rpc-api",
    "rxjs": "^7.8.2",
    "safe-stable-stringify": "^2.5.0",
    "ts-json-schema-generator": "^2.9.0",
    "utils-disposables": "file:../utils-disposables",
    "utils-logger": "file:../utils-logger",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-languageserver-types": "^3.18.3",
    "vscode-uri": "^3.2.0"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
